            </Setter.Value>
        </Setter>
    </Style>

    <!-- Statistic Card -->
    <Style x:Key="StatCard" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="8"/>
        <Setter Property="Effect">
