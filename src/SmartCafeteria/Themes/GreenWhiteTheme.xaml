<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand palette -->
    <Color x:Key="PrimaryColor">#1E7A46</Color>
    <Color x:Key="PrimaryLightColor">#2E9E5B</Color>
    <Color x:Key="PrimaryDarkColor">#14532D</Color>
    <Color x:Key="SecondaryColor">#86C58F</Color>
    <Color x:Key="SurfaceColor">#F4F7F5</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#1B241E</Color>
    <Color x:Key="TextSecondaryColor">#6B7A70</Color>
    <Color x:Key="ErrorColor">#D63232</Color>
    <Color x:Key="WarningColor">#E8880C</Color>
    <Color x:Key="InfoColor">#1E6FA8</Color>
    <Color x:Key="DividerColor">#E3E9E5</Color>
    <Color x:Key="BackgroundColor">#F4F7F5</Color>
    <Color x:Key="SidebarTextColor">#FFFFFF</Color>
    <Color x:Key="PrimarySoftColor">#E6F4EB</Color>
    <Color x:Key="HoverSoftColor">#EFF8F2</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}"/>
    <SolidColorBrush x:Key="HoverSoftBrush" Color="{StaticResource HoverSoftColor}"/>

    <!-- Sidebar gradient -->
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2C8A52" Offset="0"/>
        <GradientStop Color="#1A5C36" Offset="0.55"/>
        <GradientStop Color="#123E25" Offset="1"/>
    </LinearGradientBrush>

    <!-- Button gradient -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2C944F" Offset="0"/>
        <GradientStop Color="#1E7A46" Offset="1"/>
    </LinearGradientBrush>

    <!-- Status Colors -->
    <SolidColorBrush x:Key="StatusReceivedBrush" Color="#1E6FA8"/>
    <SolidColorBrush x:Key="StatusPreparingBrush" Color="#8B5FBF"/>
    <SolidColorBrush x:Key="StatusReadyBrush" Color="#E8880C"/>
    <SolidColorBrush x:Key="StatusCompletedBrush" Color="#1E7A46"/>
    <SolidColorBrush x:Key="StatusCancelledBrush" Color="#D63232"/>

</ResourceDictionary>