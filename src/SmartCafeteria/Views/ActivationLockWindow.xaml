<Window x:Class="SmartCafeteria.Views.ActivationLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SmartCafeteria.Views"
        Title="تفعيل نظام الكافتيريا"
        Icon="pack://application:,,,/Resources/AppIcon.ico"
        Height="720" Width="860"
        MinHeight="620" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource BackgroundBrush}">

    <Border BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2" CornerRadius="14" Margin="12">
        <DockPanel Margin="24">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="☕" FontSize="34" HorizontalAlignment="Center"/>
                <TextBlock Text="تفعيل نظام الكافتيريا الذكي" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Text="يلزم تفعيل البرنامج للمتابعة. استخدم طلب التفعيل ورمز التفعيل أدناه."
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <Button DockPanel.Dock="Bottom" Content="إغلاق البرنامج"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" Margin="0,16,0,0"
                    Click="Exit_Click"
                    AutomationProperties.AutomationId="ExitActivationButton"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource CardBorder}" Margin="0">
                    <views:ActivationPanel/>
                </Border>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
