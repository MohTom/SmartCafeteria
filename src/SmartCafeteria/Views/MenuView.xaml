<UserControl x:Class="SmartCafeteria.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartCafeteria.ViewModels"
             xmlns:conv="clr-namespace:SmartCafeteria.Converters">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="القائمة" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" DockPanel.Dock="Right"/>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="🛒" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CartCount, StringFormat='سلة المشتريات ({0})'}" 
                               FontSize="16" VerticalAlignment="Center" Cursor="Hand"
                               Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Search and Categories -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
            <StackPanel>
                <TextBox x:Name="SearchBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBox}"
                         AutomationProperties.AutomationId="SearchBox"
                         Margin="0,0,0,10"/>
                <WrapPanel>
                    <RadioButton Content="جميع الفئات" GroupName="Category" IsChecked="True"
                                 Style="{StaticResource CategoryChip}"
                                 Command="{Binding CategoryChangedCommand}" CommandParameter="all"/>
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding NameAr}" GroupName="Category"
                                             Style="{StaticResource CategoryChip}"
                                             Command="{Binding DataContext.CategoryChangedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             CommandParameter="{Binding Id}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Products Grid + Cart Panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Products -->
            <ScrollViewer Grid.Column="0">
                <ItemsControl ItemsSource="{Binding Products}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="220" Margin="4">
                                <Button Style="{StaticResource ProductCardButton}" Cursor="Hand"
                                        ToolTip="إضافة سريعة للسلة"
                                        AutomationProperties.Name="إضافة سريعة"
                                        Command="{Binding DataContext.QuickAddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding NameAr}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding NameEn}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,0">
                                            <Run Text="{Binding Price, StringFormat='{}{0}'}"/>
                                            <Run Text="{Binding DataContext.Settings.CurrencyAr, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </TextBlock>
                                        <Border Background="#FFF3E0" CornerRadius="4" Padding="6,3" HorizontalAlignment="Right" Margin="0,6,0,0"
                                                Visibility="{Binding Inventory, Converter={StaticResource InventoryToVisibilityConverter}}">
                                            <TextBlock FontSize="10" Foreground="{StaticResource WarningBrush}">
                                                <Run Text="المخزون:"/>
                                                <Run Text="{Binding Inventory}"/>
                                            </TextBlock>
                                        </Border>
                                        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="8" Padding="8,6" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                                            <TextBlock Text="اضغط للإضافة + " Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Cart Panel: items scroll in the middle row, totals + confirm pinned at the bottom -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="سلة المشتريات" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Cart}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Margin="0,0,0,8" CornerRadius="10"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Product.NameAr}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding Product.Price, StringFormat='{}{0}'}"/>
                                                    <Run Text=" × "/>
                                                    <Run Text="{Binding Quantity}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="+" Style="{StaticResource IconButton}"
                                                        Command="{Binding DataContext.IncrementQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Width="28" Height="28" Margin="4,0"/>
                                                <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center" Width="24" TextAlignment="Center"/>
                                                <Button Content="-" Style="{StaticResource IconButton}"
                                                        Command="{Binding DataContext.DecrementQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Width="28" Height="28" Margin="4,0"/>
                                                <Button Content="✕" Style="{StaticResource DangerIconButton}"
                                                        Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Margin="4,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Totals (pinned) -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Separator Margin="0,0,0,10"/>
                        <DockPanel>
                            <TextBlock Text="المجموع الفرعي:" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CartSubtotal, StringFormat='{}{0:F2}'}" HorizontalAlignment="Left"/>
                        </DockPanel>
                        <DockPanel Margin="0,8">
                            <TextBlock Text="الإجمالي:" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="{Binding CartTotal, StringFormat='{}{0:F2}'}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Left"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </DockPanel>

                        <!-- Payment method, order type and the order note share one row.
                             Each control keeps a miniature label above it so the three
                             fit inside the 350 px cart panel without widening it. -->
                        <Grid Margin="0,12,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.3*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="طريقة الدفع:" FontWeight="SemiBold" Margin="0,0,6,4"/>
                            <ComboBox Grid.Row="1" Grid.Column="0" Style="{StaticResource CompactComboBox}"
                                      AutomationProperties.AutomationId="PaymentMethodCombo"
                                      ItemsSource="{Binding DataContext.CartViewModel.PaymentMethods, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding DataContext.CartViewModel.SelectedPaymentMethod, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Margin="0,0,6,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumArabicNameConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="0" Grid.Column="1" Text="نوع الطلب:" FontWeight="SemiBold" Margin="6,0,6,4"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource CompactComboBox}"
                                      AutomationProperties.AutomationId="OrderTypeCombo"
                                      ItemsSource="{Binding DataContext.CartViewModel.OrderTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding DataContext.CartViewModel.SelectedOrderType, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Margin="6,0,6,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumArabicNameConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="ملاحظات:" FontWeight="SemiBold" Margin="6,0,0,4"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource CompactTextBox}"
                                     AutomationProperties.AutomationId="OrderNotesInput"
                                     Text="{Binding DataContext.CartViewModel.Notes, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="200"
                                     Margin="6,0,0,0"/>
                        </Grid>

                        <Button Content="تأكيد الطلب" Style="{StaticResource PrimaryButton}"
                                Command="{Binding DataContext.CartViewModel.PlaceOrderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>

