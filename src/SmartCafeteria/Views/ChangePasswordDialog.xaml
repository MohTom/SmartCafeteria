<Window x:Class="SmartCafeteria.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تغيير كلمة المرور"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFontFamily}"
        Background="White">
    <Border Padding="28,24">
        <StackPanel>
            <TextBlock Text="تغيير كلمة المرور" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,6"/>
            <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,18"/>

            <TextBlock Text="كلمة المرور الحالية" Margin="0,0,0,4"/>
            <PasswordBox x:Name="CurrentPasswordInput" Style="{StaticResource ModernPasswordBox}"
                         Margin="0,0,0,12"/>

            <TextBlock Text="كلمة المرور الجديدة" Margin="0,0,0,4"/>
            <PasswordBox x:Name="NewPasswordInput" Style="{StaticResource ModernPasswordBox}"
                         Margin="0,0,0,4"/>
            <TextBlock x:Name="PolicyHint" FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

            <TextBlock Text="تأكيد كلمة المرور الجديدة" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ConfirmPasswordInput" Style="{StaticResource ModernPasswordBox}"
                         Margin="0,0,0,12"/>

            <TextBlock x:Name="ErrorText" Foreground="#C0392B" FontSize="12" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="ConfirmButton" Content="تغيير كلمة المرور"
                        Style="{StaticResource PrimaryButton}" MinWidth="170" Click="Confirm_Click"/>
                <Button x:Name="CancelButton" Content="إلغاء" Style="{StaticResource SecondaryButton}"
                        MinWidth="100" Margin="10,0,0,0" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
