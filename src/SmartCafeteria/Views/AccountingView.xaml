<UserControl x:Class="SmartCafeteria.Views.AccountingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="المحاسبة" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock DockPanel.Dock="Left" Text="الإيرادات والمصروفات وصافي الربح" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,6,0,0"/>
            </DockPanel>
        </Border>

        <!-- Range + Stats -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="الفترة" Style="{StaticResource FormLabel}"/>
                    <ComboBox Style="{StaticResource ModernComboBox}" ItemsSource="{Binding RangeOptions}"
                              SelectedItem="{Binding RangeKey}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="إجمالي الإيرادات" Style="{StaticResource FormLabel}"/>
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">
                        <Run Text="{Binding Income, StringFormat='{}{0:N0}', Mode=OneWay}"/>
                        <Run Text="{Binding Settings.CurrencyAr, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="إجمالي المصروفات" Style="{StaticResource FormLabel}"/>
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource WarningBrush}">
                        <Run Text="{Binding Expenses, StringFormat='{}{0:N0}', Mode=OneWay}"/>
                        <Run Text="{Binding Settings.CurrencyAr, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="صافي الربح" Style="{StaticResource FormLabel}"/>
                    <TextBlock FontSize="24" FontWeight="Bold">
                        <Run Text="{Binding Net, StringFormat='{}{0:N0}', Mode=OneWay}"/>
                        <Run Text="{Binding Settings.CurrencyAr, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="عدد الطلبات" Style="{StaticResource FormLabel}"/>
                    <TextBlock Text="{Binding OrderCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource InfoBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Content: ledger + expenses -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="430"/>
            </Grid.ColumnDefinitions>

            <!-- Ledger -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="سجل القيود المالية" Style="{StaticResource SectionTitle}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Ledger}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Margin="0,0,0,8" Background="#F8FAF9" CornerRadius="10">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Left">
                                                <TextBlock FontWeight="Bold" FontSize="15" TextAlignment="Right">
                                                    <Run>
                                                        <Run.Style>
                                                            <Style TargetType="Run">
                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsIncome}" Value="False">
                                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Run.Style>
                                                    </Run>
                                                    <Run Text="{Binding Amount, Mode=OneWay, StringFormat='{}{0:N2}'}"/>
                                                    <Run Text="{Binding DataContext.Settings.CurrencyAr, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="10"/>
                                                </TextBlock>
                                                <Border Background="#E6F4EB" CornerRadius="6" Padding="8,3" Margin="0,4,0,0" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding IsIncome, Mode=OneWay, Converter={StaticResource EnumArabicNameConverter}}"
                                                               FontSize="10" Foreground="{StaticResource PrimaryBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding Date, Mode=OneWay, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"/>
                                                    <Run Text=" • "/>
                                                    <Run Text="{Binding Description, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Reference}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Expenses -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock Text="المصروفات" Style="{StaticResource SectionTitle}"/>
                        <Button DockPanel.Dock="Right" Content="+ إضافة مصروف" Style="{StaticResource PrimaryButton}"
                                Padding="16,10" Command="{Binding OpenExpenseDialogCommand}" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Margin="0,0,0,8" Background="#FCF6EF" CornerRadius="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" FontSize="13"/>
                                                    <Border DockPanel.Dock="Right" Background="#FFF0DA" CornerRadius="6" Padding="8,3">
                                                        <TextBlock Text="{Binding Category, Mode=OneWay, Converter={StaticResource EnumArabicNameConverter}}"
                                                                   FontSize="10" Foreground="{StaticResource WarningBrush}"/>
                                                    </Border>
                                                </DockPanel>
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                                                    <Run Text="{Binding Date, Mode=OneWay, StringFormat='{}{0:dd/MM/yyyy}'}"/>
                                                    <Run Text=" • "/>
                                                    <Run Text="{Binding PaymentMethod, Mode=OneWay, Converter={StaticResource EnumArabicNameConverter}}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock FontSize="15" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Run Text="{Binding Amount, Mode=OneWay, StringFormat='{}{0:N2}'}"/>
                                                    <Run Text="{Binding DataContext.Settings.CurrencyAr, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11"/>
                                                </TextBlock>
                                                <Button Style="{StaticResource IconButton}" ToolTip="تعديل" Margin="2"
                                                        Command="{Binding DataContext.OpenEditExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    ✏
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" ToolTip="حذف" Margin="2" Background="#FDECEC" Foreground="{StaticResource ErrorBrush}"
                                                        Command="{Binding DataContext.DeleteExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Id}">
                                                    🗑
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Expense dialog overlay -->
            <Border Grid.ColumnSpan="2" Background="#80000000"
                    Visibility="{Binding ShowExpenseDialog, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="White" CornerRadius="16" Width="460" Padding="28"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="تسجيل مصروف" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                        <TextBlock Text="الوصف" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="ExpenseDescriptionBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                                 Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="الفئة" Style="{StaticResource FormLabel}"/>
                        <ComboBox Style="{StaticResource ModernComboBox}" Margin="0,0,0,12"
                                  ItemsSource="{Binding ExpenseCategories}"
                                  SelectedItem="{Binding NewCategory}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumArabicNameConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="المبلغ" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="ExpenseAmountBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                                 Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="التاريخ" Style="{StaticResource FormLabel}"/>
                        <DatePicker SelectedDate="{Binding NewDate}" Margin="0,0,0,12" Style="{StaticResource ModernDatePicker}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="حفظ المصروف" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"
                                    Command="{Binding SaveExpenseCommand}"/>
                            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CloseExpenseDialogCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>


