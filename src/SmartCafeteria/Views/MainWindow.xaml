<Window x:Class="SmartCafeteria.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SmartCafeteria.ViewModels"
        xmlns:views="clr-namespace:SmartCafeteria.Views"
        Title="نظام الكافتيريا الذكي"
        Icon="pack://application:,,,/Resources/AppIcon.ico"
        Height="800" Width="1400"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource BackgroundBrush}">

<Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <!-- Logo -->
                <Border DockPanel.Dock="Top" Padding="20" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="☕" FontSize="36" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Settings.CafeteriaNameAr}" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="نظام إدارة الكافتيريا" FontSize="11" Foreground="#AAFFFFFF" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <RadioButton Style="{StaticResource NavButton}" IsChecked="True"
                                 Command="{Binding NavigateCommand}" CommandParameter="القائمة">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🍽" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="القائمة" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}"
                                 Command="{Binding NavigateCommand}" CommandParameter="الطلبات">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="الطلبات" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}"
                                 Command="{Binding NavigateCommand}" CommandParameter="المخزون">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="المخزون" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
<RadioButton Style="{StaticResource NavButton}"
                                  Command="{Binding NavigateCommand}" CommandParameter="التقارير"
                                  Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="التقارير" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}"
                                 Command="{Binding NavigateCommand}" CommandParameter="المحاسبة"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💰" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="المحاسبة" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}"
                                 Command="{Binding NavigateCommand}" CommandParameter="الموردون"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚚" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="الموردون" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}"
                                 Command="{Binding NavigateCommand}" CommandParameter="الموظفون"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧑‍🍳" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="الموظفون" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}"
                                 Command="{Binding NavigateCommand}" CommandParameter="المستخدمون"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="المستخدمون" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}"
                                  Command="{Binding NavigateCommand}" CommandParameter="الإعدادات"
                                  Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="الإعدادات" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Bottom -->
<Button DockPanel.Dock="Bottom" Content="تسجيل الخروج" Style="{StaticResource SidebarButton}" Margin="10,0,10,10"
        Command="{Binding LogoutCommand}"/>
<Border DockPanel.Dock="Bottom" Padding="15" Margin="10,0,10,10" Background="#33FFFFFF" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentUserName}" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding CurrentStationName}" Foreground="#AAFFFFFF" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- License Status -->
                <Border DockPanel.Dock="Bottom" Padding="10,8" Margin="10,0,10,8" Background="#22FFFFFF" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="الترخيص" Foreground="White" FontWeight="Bold" FontSize="11" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding Activation.LicenseStatusText}" Foreground="#CCFFFFFF"
                                   FontSize="10" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="SidebarLicenseStatus"/>
                    </StackPanel>
                </Border>

                <!-- System Logs -->
                <Border DockPanel.Dock="Bottom" Padding="10" Margin="10,0,10,10" Background="#22FFFFFF" CornerRadius="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="سجل العمليات" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                        <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0"
                                 Foreground="#CCFFFFFF" FontSize="10" MaxHeight="120">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Column="1" Margin="20">
            <!-- ContentControl binds to CurrentViewModel; implicit templates live in Themes/DataTemplates.xaml -->
            <ContentControl x:Name="ContentHost" Content="{Binding CurrentViewModel}" Margin="0,0,0,20"/>

            <!-- Notification Toast -->
<Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Style="{StaticResource Toast}"
                    Background="{Binding NotificationBackground}"
                    Padding="16,10"
                    Visibility="{Binding ShowNotification, Converter={StaticResource BoolToVisibilityConverter}}"
                    Panel.ZIndex="100">
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <TextBlock Text="{Binding NotificationMessage}" FontSize="13" Foreground="White"/>
            </Border>
        </Grid>
    </Grid>
</Window>

