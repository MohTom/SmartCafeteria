<UserControl x:Class="SmartCafeteria.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="الموردون" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                <Button DockPanel.Dock="Left" Content="+ إضافة مورد" Style="{StaticResource PrimaryButton}" Padding="16,10"
                        Command="{Binding OpenSupplierDialogCommand}"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Suppliers list -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <TextBlock Text="قائمة الموردين" Style="{StaticResource SectionTitle}"/>
                    <ListBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" Margin="0,0,0,8" CornerRadius="12" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F8FAF9"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                            <Border Margin="0,8,0,0" Background="#E6F4EB" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="الرصيد: " FontSize="10"/>
                                                    <TextBlock FontSize="10" Foreground="{StaticResource PrimaryBrush}">
                                                        <Run Text="{Binding Balance, StringFormat='{}{0:N2}', Mode=OneWay}"/>
                                                        <Run Text="{Binding DataContext.Settings.CurrencyAr, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="9"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" ToolTip="تعديل" Margin="2"
                                                    Command="{Binding DataContext.OpenEditSupplierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                ✏
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" ToolTip="حذف" Margin="2" Background="#FDECEC" Foreground="{StaticResource ErrorBrush}"
                                                    Command="{Binding DataContext.DeleteSupplierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}">
                                                🗑
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Details -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <Grid>
                    <TextBlock Text="اختر مورداً لعرض التفاصيل والطلبات والدفعات"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SelectedSupplier, Converter={StaticResource NullToInverseVisibilityConverter}}"/>

                    <StackPanel Visibility="{Binding SelectedSupplier, Converter={StaticResource NullToVisibilityConverter}}">
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right">
                                <TextBlock FontSize="20" FontWeight="Bold" Margin="0,0,0,4">
                                    <Run Text="{Binding SelectedSupplier.Name, Mode=OneWay}"/>
                                    <Run Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Text="{Binding SelectedSupplier.Phone}"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Content="إنشاء أمر شراء" Style="{StaticResource PrimaryButton}" Padding="14,9" Margin="0,0,8,0"
                                    Command="{Binding OpenPoDialogCommand}"/>
                            <Button Content="تسجيل دفعة" Style="{StaticResource SecondaryButton}" Padding="14,9"
                                    Command="{Binding OpenPaymentDialogCommand}"/>
                        </DockPanel>

                        <Border Background="#F6F9F6" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <DockPanel>
                                <TextBlock Text="المديونية الحالية" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock HorizontalAlignment="Left" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource ErrorBrush}">
                                    <Run Text="{Binding Balance, StringFormat='{}{0:N2}', Mode=OneWay}"/>
                                    <Run Text="{Binding Settings.CurrencyAr}" FontSize="12"/>
                                </TextBlock>
                            </DockPanel>
                        </Border>

                        <!-- Purchase orders -->
                        <TextBlock Text="أوامر الشراء" Style="{StaticResource SectionTitle}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="230">
                            <ItemsControl ItemsSource="{Binding PurchaseOrders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10" Margin="0,0,0,8" Background="#F8FAF9" CornerRadius="10">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FFF0DA"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Received">
                                                                    <Setter Property="Background" Value="#E6F4EB"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                    <Setter Property="Background" Value="#FDECEC"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status, Mode=OneWay, Converter={StaticResource EnumArabicNameConverter}}"
                                                               FontSize="10" Foreground="{StaticResource WarningBrush}"/>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock FontSize="13" FontWeight="SemiBold">
                                                        <Run Text="{Binding Code, Mode=OneWay}"/>
                                                        <Run Text=" - "/>
                                                        <Run Text="{Binding Date, Mode=OneWay, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" Margin="0,4,0,0" Text="{Binding Notes}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock FontSize="11" Margin="0,1">
                                                                    <Run Text="{Binding ProductName, Mode=OneWay}"/>
                                                                    <Run Text=" × "/>
                                                                    <Run Text="{Binding Quantity, Mode=OneWay}"/>
                                                                    <Run Text=" ("/>
                                                                    <Run Text="{Binding UnitCost, Mode=OneWay, StringFormat='{}{0}'}"/>
                                                                    <Run Text="{Binding DataContext.Settings.CurrencyAr, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                                                                    <Run Text=")"/>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <DockPanel Margin="0,8,0,0">
                                                        <TextBlock Text="الإجمالي:" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock HorizontalAlignment="Left" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">
                                                            <Run Text="{Binding TotalAmount, Mode=OneWay, StringFormat='{}{0:N2}'}"/>
                                                            <Run Text="{Binding DataContext.Settings.CurrencyAr, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="10"/>
                                                        </TextBlock>
                                                        <Button DockPanel.Dock="Left" Content="إلغاء" Style="{StaticResource DangerButton}" Padding="12,7" Margin="4,0"
                                                                Visibility="{Binding Status, Converter={StaticResource PurchaseOrderStatusToVisibilityConverter}, ConverterParameter=Pending}"
                                                                Command="{Binding DataContext.CancelPoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding Id}"/>
                                                        <Button DockPanel.Dock="Left" Content="استلام" Style="{StaticResource PrimaryButton}" Padding="12,7" Margin="4,0"
                                                                Visibility="{Binding Status, Converter={StaticResource PurchaseOrderStatusToVisibilityConverter}, ConverterParameter=Pending}"
                                                                Command="{Binding DataContext.ReceivePoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding Id}"/>
                                                    </DockPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Payments -->
                        <TextBlock Text="الدفعات المسجلة" Style="{StaticResource SectionTitle}" Margin="0,12,0,12"/>
                        <ItemsControl ItemsSource="{Binding Payments}" MaxHeight="150">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Margin="0,0,0,6" Background="#F8FAF9" CornerRadius="8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">
                                                <Run Text="{Binding Amount, Mode=OneWay, StringFormat='{}{0:N2}'}"/>
                                                <Run FontSize="10" Text="{Binding DataContext.Settings.CurrencyAr, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </TextBlock>
                                            <TextBlock>
                                                <Run Text="{Binding Date, Mode=OneWay, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <Run Text=" • " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <Run Text="{Binding PaymentMethod, Mode=OneWay, Converter={StaticResource EnumArabicNameConverter}}" FontSize="11"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Supplier dialog -->
            <Border Grid.ColumnSpan="2" Background="#80000000"
                    Visibility="{Binding ShowSupplierDialog, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="White" CornerRadius="16" Width="460" Padding="28"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="بيانات المورد" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                        <TextBlock Text="اسم المورد" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="SupplierNameBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                                 Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="رقم الهاتف" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="SupplierPhoneBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                                 Text="{Binding NewPhone, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="البريد الإلكتروني" Style="{StaticResource FormLabel}"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                                 Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="العنوان" Style="{StaticResource FormLabel}"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                                 Text="{Binding NewAddress, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="ملاحظات" Style="{StaticResource FormLabel}"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                                 Text="{Binding NewNotes, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="حفظ المورد" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"
                                    Command="{Binding SaveSupplierCommand}"/>
                            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CloseSupplierDialogCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- PO dialog -->
            <Border Grid.ColumnSpan="2" Background="#80000000"
                    Visibility="{Binding ShowPoDialog, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="White" CornerRadius="16" Width="560" MaxHeight="640" Padding="28"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ScrollViewer>
                        <StackPanel>
                            <TextBlock Text="إنشاء أمر شراء" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedSupplier.Name}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>
                            <TextBlock Text="المنتج" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="PoProductCombo" Style="{StaticResource ModernComboBox}" Margin="0,0,0,10"
                                      ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedPoProduct}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NameAr}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="الكمية" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="PoQtyBox" Style="{StaticResource ModernTextBox}" Text="{Binding PoQuantity, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="سعر الوحدة" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="PoCostBox" Style="{StaticResource ModernTextBox}" Text="{Binding PoUnitCost, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Padding="16,10"
                                        Content="إضافة سطر"
                                        Command="{Binding AddPoLineCommand}"
                                        CommandParameter="{Binding SelectedItem, ElementName=PoProductCombo}"/>
                            </Grid>
                            <TextBlock Text="بنود الطلب" Style="{StaticResource FormLabel}"/>
                            <ItemsControl ItemsSource="{Binding PoLines}" MaxHeight="140">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <TextBlock Text="{Binding ProductName}" FontSize="13"/>
                                            <Button DockPanel.Dock="Left" Content="✕" Width="24" Height="24" Background="#FDECEC"
                                                    Foreground="{StaticResource ErrorBrush}" BorderThickness="0" FontSize="11"
                                                    Command="{Binding DataContext.RemovePoLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Right">
                                                <Run Text="× "/>
                                                <Run Text="{Binding Quantity, Mode=OneWay}"/>
                                                <Run Text=" = "/>
                                                <Run Text="{Binding Total, Mode=OneWay, StringFormat='{}{0:N2}'}"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="ملاحظات" Style="{StaticResource FormLabel}" Margin="0,10,0,4"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding PoNotes, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock Text="إجمالي الطلب:" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock HorizontalAlignment="Left" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">
                                    <Run Text="{Binding PoTotal, Mode=OneWay, StringFormat='{}{0:N2}'}"/>
                                    <Run Text="{Binding Settings.CurrencyAr}" FontSize="11"/>
                                </TextBlock>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="إنشاء الأمر" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"
                                        Command="{Binding CreatePoCommand}"/>
                                <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Command="{Binding ClosePoDialogCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Border>

            <!-- Payment dialog -->
            <Border Grid.ColumnSpan="2" Background="#80000000"
                    Visibility="{Binding ShowPaymentDialog, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="White" CornerRadius="16" Width="420" Padding="28"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="تسجيل دفعة للمورد" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedSupplier.Name}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>
                        <TextBlock Text="المبلغ" Style="{StaticResource FormLabel}"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                                 Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="طريقة الدفع" Style="{StaticResource FormLabel}"/>
                        <ComboBox Style="{StaticResource ModernComboBox}" Margin="0,0,0,12"
                                  ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumArabicNameConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="ملاحظات" Style="{StaticResource FormLabel}"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding PaymentNotes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="حفظ الدفعة" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"
                                    Command="{Binding SavePaymentCommand}"/>
                            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Command="{Binding ClosePaymentDialogCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>


