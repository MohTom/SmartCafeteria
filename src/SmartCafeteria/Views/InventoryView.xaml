<UserControl x:Class="SmartCafeteria.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartCafeteria.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="إدارة المخزون" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" DockPanel.Dock="Right"/>
                <Button Content="إضافة منتج جديد" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Left"
                        Command="{Binding StartAddCommand}"/>
            </DockPanel>
        </Border>

        <!-- Search -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource ModernTextBox}"/>
        </Border>

        <!-- Products Grid -->
        <Grid Grid.Row="2">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Products}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Width="280" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="{Binding NameAr}" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding NameEn}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Price, StringFormat='السعر: {0}'}" Margin="0,8,0,4"/>
                                    
                                    <!-- Stock bar -->
                                    <TextBlock Text="المخزون:" FontSize="11" Margin="0,4,0,4"/>
                                    <Grid Height="8">
                                        <Border Background="#E0E0E0" CornerRadius="4"/>
                                        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="4" HorizontalAlignment="Left"
                                                Width="{Binding InventoryPercentWidth}"/>
                                    </Grid>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="{Binding Inventory}"/>
                                        <Run Text=" / "/>
                                        <Run Text="{Binding MaxInventory}"/>
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="تعبئة" Style="{StaticResource PrimaryButton}" FontSize="11" Padding="8,4" Margin="0,0,6,0"
                                                Command="{Binding DataContext.RestockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}"/>
                                        <Button Content="تعديل" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="8,4" Margin="0,0,6,0"
                                                Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="حذف" Style="{StaticResource DangerButton}" FontSize="11" Padding="8,4"
                                                Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Add/Edit Form Overlay -->
            <Border Background="#80000000" Visibility="{Binding IsAdding, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="White" CornerRadius="16" Width="760" MaxHeight="640"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
                    <ScrollViewer>
                        <StackPanel>
                            <TextBlock Text="إضافة منتج جديد" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                    <TextBlock Text="اسم المنتج بالعربي:" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding NewNameAr}" Style="{StaticResource ModernTextBox}"
                                             AutomationProperties.AutomationId="AddNameAr"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                                    <TextBlock Text="اسم المنتج بالإنجليزي:" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding NewNameEn}" Style="{StaticResource ModernTextBox}"
                                             AutomationProperties.AutomationId="AddNameEn"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                                    <TextBlock Text="الوصف بالعربي:" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding NewDescriptionAr}" Style="{StaticResource ModernTextBox}"
                                             AutomationProperties.AutomationId="AddDescriptionAr"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10">
                                    <TextBlock Text="الوصف بالإنجليزي:" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding NewDescriptionEn}" Style="{StaticResource ModernTextBox}"
                                             AutomationProperties.AutomationId="AddDescriptionEn"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,10">
                                    <TextBlock Text="السعر:" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding NewPrice}" Style="{StaticResource ModernTextBox}"
                                             AutomationProperties.AutomationId="AddPrice"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,10">
                                    <TextBlock Text="الفئة:" Margin="0,0,0,4"/>
                                    <ComboBox Style="{StaticResource ModernComboBox}" ItemsSource="{Binding Categories}"
                                              DisplayMemberPath="NameAr" SelectedValuePath="Id"
                                              SelectedValue="{Binding NewCategory}"
                                              AutomationProperties.AutomationId="AddCategory"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,16"
                                            Visibility="{Binding EnforceInventoryTracking, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="المخزون:" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding NewInventory}" Style="{StaticResource ModernTextBox}"
                                             AutomationProperties.AutomationId="AddInventory"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,16"
                                            Visibility="{Binding EnforceInventoryTracking, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="الحد الأقصى:" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding NewMaxInventory}" Style="{StaticResource ModernTextBox}"
                                             AutomationProperties.AutomationId="AddMaxInventory"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="إضافة" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"
                                        Command="{Binding AddProductCommand}"/>
                                <Button Content="إلغاء" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CancelEditCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Border>

            <!-- Edit Form Overlay -->
            <Border Background="#80000000" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="White" CornerRadius="16" Width="760" MaxHeight="640"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
                    <ScrollViewer>
                        <StackPanel>
                            <TextBlock Text="تعديل المنتج" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                    <TextBlock Text="اسم المنتج بالعربي:" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditNameAr}" Style="{StaticResource ModernTextBox}"
                                             AutomationProperties.AutomationId="EditNameAr"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                                    <TextBlock Text="اسم المنتج بالإنجليزي:" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditNameEn}" Style="{StaticResource ModernTextBox}"
                                             AutomationProperties.AutomationId="EditNameEn"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                                    <TextBlock Text="الوصف بالعربي:" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditDescriptionAr}" Style="{StaticResource ModernTextBox}"
                                             AutomationProperties.AutomationId="EditDescriptionAr"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10">
                                    <TextBlock Text="الوصف بالإنجليزي:" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditDescriptionEn}" Style="{StaticResource ModernTextBox}"
                                             AutomationProperties.AutomationId="EditDescriptionEn"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,10">
                                    <TextBlock Text="السعر:" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditPrice}" Style="{StaticResource ModernTextBox}"
                                             AutomationProperties.AutomationId="EditPrice"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,10">
                                    <TextBlock Text="الفئة:" Margin="0,0,0,4"/>
                                    <ComboBox Style="{StaticResource ModernComboBox}" ItemsSource="{Binding Categories}"
                                              DisplayMemberPath="NameAr" SelectedValuePath="Id"
                                              SelectedValue="{Binding EditCategory}"
                                              AutomationProperties.AutomationId="EditCategory"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,16"
                                            Visibility="{Binding EnforceInventoryTracking, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="المخزون:" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditInventory}" Style="{StaticResource ModernTextBox}"
                                             AutomationProperties.AutomationId="EditInventory"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,16"
                                            Visibility="{Binding EnforceInventoryTracking, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="الحد الأقصى:" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditMaxInventory}" Style="{StaticResource ModernTextBox}"
                                             AutomationProperties.AutomationId="EditMaxInventory"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"
                                        Command="{Binding SaveEditCommand}"/>
                                <Button Content="إلغاء" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CancelEditCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
