<UserControl x:Class="SmartCafeteria.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartCafeteria.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
            <TextBlock Text="إدارة الطلبات" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
        </Border>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
            <WrapPanel>
                <RadioButton Content="الكل" GroupName="StatusFilter" Style="{StaticResource CategoryChip}"
                             Command="{Binding StatusFilterChangedCommand}" CommandParameter="all"/>
                <RadioButton Content="تم الاستلام" GroupName="StatusFilter" IsChecked="True" Style="{StaticResource CategoryChip}"
                             Command="{Binding StatusFilterChangedCommand}" CommandParameter="received"/>
                <RadioButton Content="ملغي" GroupName="StatusFilter" Style="{StaticResource CategoryChip}"
                             Command="{Binding StatusFilterChangedCommand}" CommandParameter="cancelled"/>
            </WrapPanel>
        </Border>

        <!-- Orders List -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Orders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Code}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryBrush}"/>
                                        <Border HorizontalAlignment="Left" Padding="8,3" CornerRadius="6">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource EnumArabicNameConverter}}" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}التاريخ: {0:yyyy/MM/dd HH:mm}'}" 
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4"/>
                                    <TextBlock Text="{Binding CashierName, StringFormat='الكاشير: {0}'}" FontSize="12"/>
                                    <TextBlock FontSize="12" Margin="0,4,0,0">
                                        <Run Text="نوع الطلب: "/>
                                        <Run Text="{Binding OrderType, Converter={StaticResource EnumArabicNameConverter}, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Notes, StringFormat='ملاحظات: {0}'}" FontSize="12" Margin="0,4,0,0"
                                               Visibility="{Binding Notes, Converter={StaticResource NonEmptyStringToVisibilityConverter}}"/>

                                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="12" Margin="0,2">
                                                    <Run Text="{Binding Quantity}"/>
                                                    <Run Text="× "/>
                                                    <Run Text="{Binding ProductNameAr}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{Binding ProductPrice, StringFormat='{}{0:F2}'}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding Total, StringFormat='الإجمالي: {0:F2}'}" FontWeight="Bold" FontSize="14" Margin="0,8,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                    <Button Content="إلغاء" Style="{StaticResource DangerButton}" FontSize="11" Padding="10,6" Margin="0,4"
                                            Command="{Binding DataContext.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="طباعة" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,6" Margin="0,4"
                                            Command="{Binding DataContext.PrintReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="حذف نهائي" Style="{StaticResource DangerButton}" FontSize="11" Padding="10,6" Margin="0,4"
                                            Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding DataContext.DeleteOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
