<UserControl x:Class="SmartCafeteria.Views.ReportsAnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <StackPanel>

        <!-- Header -->
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="التحليلات التفصيلية" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" DockPanel.Dock="Right"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Content="تحديث" Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}"/>
                    <Button Content="📄 تصدير التقرير الشامل" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ExportAllCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Period filter, independent from the report above -->
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="نطاق التحليلات:" FontWeight="SemiBold" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource PrimaryBrush}" CornerRadius="8" Padding="12,4"
                            DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PeriodLabel}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </DockPanel>
                <WrapPanel Margin="0,0,0,10">
                    <Button Content="يومي" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="16,6"
                            Command="{Binding ApplyPeriodCommand}" CommandParameter="daily"/>
                    <Button Content="أسبوعي" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="16,6"
                            Command="{Binding ApplyPeriodCommand}" CommandParameter="weekly"/>
                    <Button Content="شهري" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="16,6"
                            Command="{Binding ApplyPeriodCommand}" CommandParameter="monthly"/>
                    <Button Content="الكل" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="16,6"
                            Command="{Binding ApplyPeriodCommand}" CommandParameter="all"/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="من:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding StartDate}" Margin="0,0,20,0" Width="160"
                                Style="{StaticResource ModernDatePicker}"/>
                    <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding EndDate}" Width="160"
                                Style="{StaticResource ModernDatePicker}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Headline figures -->
        <ItemsControl ItemsSource="{Binding Kpis}" Margin="0,0,0,4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Width="196" Margin="4">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Value}" FontSize="17" FontWeight="Bold" Margin="0,6,0,0"
                                       Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryBrush}"
                   Margin="6,4,6,8" TextWrapping="Wrap"/>

        <!-- One card per report -->
        <ItemsControl ItemsSource="{Binding Sections}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}" DockPanel.Dock="Right"
                                           VerticalAlignment="Center"/>
                                <Button Content="📄 PDF" Style="{StaticResource SecondaryButton}"
                                        Padding="12,4" DockPanel.Dock="Left" VerticalAlignment="Center"
                                        Command="{Binding DataContext.ExportReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Kind}"/>
                            </DockPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.8*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.ColumnSpan="5" Background="{StaticResource PrimaryBrush}"
                                        CornerRadius="6" Padding="8,6"/>
                                <TextBlock Grid.Column="0" Text="#" Foreground="White" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Column0}" Foreground="White" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Column1}" Foreground="White" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Column2}" Foreground="White" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding Column3}" Foreground="White" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="{Binding EmptyMessage}" FontStyle="Italic" Margin="8,10,8,4"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <ItemsControl ItemsSource="{Binding Rows}"
                                          Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E4EBE5" BorderThickness="0,0,0,1" Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Rank}" FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Primary}" FontSize="12" FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Secondary}" FontSize="12"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Tertiary}" FontSize="12"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Value}" FontSize="12" FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
