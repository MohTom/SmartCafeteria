<UserControl x:Class="SmartCafeteria.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartCafeteria.ViewModels"
             FlowDirection="RightToLeft">

    <ScrollViewer>
        <StackPanel Margin="0,0,0,20">
            <!-- Header -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                <DockPanel>
                    <TextBlock Text="التقارير" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" DockPanel.Dock="Right"/>
                    <Border Background="{StaticResource PrimaryBrush}" CornerRadius="8" Padding="12,4" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedPeriodLabel}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Stats Cards -->
            <WrapPanel Margin="0,0,0,12">
                <Border Style="{StaticResource CardBorder}" Width="210" Margin="6">
                    <StackPanel>
                        <TextBlock Text="💰 إجمالي الإيرادات" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Margin="0,6,0,0">
                            <Run Text="{Binding TotalRevenue, StringFormat='{}{0:F2}'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            <Run Text="{Binding Settings.CurrencyAr}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="210" Margin="6">
                    <StackPanel>
                        <TextBlock Text="🧾 عدد الطلبات" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalOrders}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource InfoBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="210" Margin="6">
                    <StackPanel>
                        <TextBlock Text="⚠ تنبيهات المخزون" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding LowStockCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Period + Date Range -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="الفترة الزمنية:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="يومي" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="16,6"
                                Command="{Binding ApplyPeriodCommand}" CommandParameter="daily"/>
                        <Button Content="أسبوعي" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="16,6"
                                Command="{Binding ApplyPeriodCommand}" CommandParameter="weekly"/>
                        <Button Content="شهري" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="16,6"
                                Command="{Binding ApplyPeriodCommand}" CommandParameter="monthly"/>
                        <Button Content="الكل" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="16,6"
                                Command="{Binding ApplyPeriodCommand}" CommandParameter="all"/>
                    </WrapPanel>
                    <TextBlock Text="نطاق مخصص (اختياري):" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="من:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,20,0" Width="160" Style="{StaticResource ModernDatePicker}"/>
                        <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}" Width="160" Style="{StaticResource ModernDatePicker}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Download Buttons -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="تحميل التقارير كـ PDF:" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,16"/>
                    <WrapPanel>
                        <Button Content="📊 تقرير المبيعات" Style="{StaticResource PrimaryButton}" Margin="0,0,12,12"
                                Command="{Binding DownloadSalesReportCommand}"/>
                        <Button Content="📋 تقرير الطلبات" Style="{StaticResource PrimaryButton}" Margin="0,0,12,12"
                                Command="{Binding DownloadOrdersReportCommand}"/>
                        <Button Content="📦 تقرير المخزون" Style="{StaticResource PrimaryButton}" Margin="0,0,12,12"
                                Command="{Binding DownloadInventoryReportCommand}"/>
                        <Button Content="📝 تقرير سجل العمليات" Style="{StaticResource PrimaryButton}" Margin="0,0,12,12"
                                Command="{Binding DownloadOperationsLogReportCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="التقارير المالية والتحليلية:" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,12"/>
                    <WrapPanel>
                        <Button Content="💵 التقرير المالي الشامل" Style="{StaticResource PrimaryButton}" Margin="0,0,12,12"
                                Command="{Binding DownloadFinancialReportCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="تقارير التحليل التفصيلي:" FontWeight="SemiBold" Margin="0,8,0,12"/>
                    <ItemsControl ItemsSource="{Binding AnalyticsButtons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Title}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" Padding="14,6"
                                        Command="{Binding DataContext.DownloadAnalyticsReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Kind}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Operations Log -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="سجل العمليات (أحدث 100)" FontWeight="SemiBold" FontSize="16" DockPanel.Dock="Right"/>
                        <TextBlock Text="{Binding RecentLogs.Count, StringFormat='{}{0} عملية'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding RecentLogs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Margin="0,0,0,6" Background="#F6F9F6" CornerRadius="8">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy/MM/dd HH:mm}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
