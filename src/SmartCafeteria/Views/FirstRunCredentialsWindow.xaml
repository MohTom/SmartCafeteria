<Window x:Class="SmartCafeteria.Views.FirstRunCredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="بيانات الدخول الأولى"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFontFamily}"
        Background="White">
    <Border Padding="28,24">
        <StackPanel>
            <TextBlock Text="تم إنشاء حساب المدير" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,6"/>
            <TextBlock Text="احفظ كلمة المرور المؤقتة الآن، فهي لا تُعرض مرة أخرى. سيُطلب منك تعيين كلمة مرور جديدة عند أول تسجيل دخول."
                       TextWrapping="Wrap" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

            <TextBlock Text="اسم المستخدم" Margin="0,0,0,4"/>
            <TextBox x:Name="UsernameBox" IsReadOnly="True" Style="{StaticResource ModernTextBox}"
                     Margin="0,0,0,12"/>

            <TextBlock Text="كلمة المرور المؤقتة" Margin="0,0,0,4"/>
            <TextBox x:Name="PasswordBox" IsReadOnly="True" Style="{StaticResource ModernTextBox}"
                     FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="16"
                     Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="نسخ كلمة المرور" Style="{StaticResource SecondaryButton}"
                        MinWidth="150" Click="Copy_Click"/>
                <Button Content="متابعة" Style="{StaticResource PrimaryButton}"
                        MinWidth="110" Margin="10,0,0,0" IsDefault="True" Click="Continue_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
