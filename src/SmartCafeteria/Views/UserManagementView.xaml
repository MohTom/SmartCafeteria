<UserControl x:Class="SmartCafeteria.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
            <TextBlock Text="إدارة المستخدمين" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
        </Border>

        <!-- Users List -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="المستخدمون" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                          Style="{StaticResource FluentDataGrid}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Single" Margin="0,0,0,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="*"/>
                        <DataGridTextColumn Header="المهنة" Binding="{Binding Role, Converter={StaticResource EnumArabicNameConverter}}" Width="90"/>
                        <DataGridCheckBoxColumn Header="مفعّل" Binding="{Binding IsActive}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Add / Edit Panel -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="إضافة مستخدم جديد" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                    <TextBlock Text="الاسم الكامل:" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                    <TextBlock Text="اسم المستخدم:" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                    <TextBlock Text="كلمة المرور:" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="NewPasswordInput" Margin="0,0,0,10" Style="{StaticResource ModernPasswordBox}"
                                 PasswordChanged="NewPasswordInput_PasswordChanged"/>

                    <TextBlock Text="المهنة:" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource ModernComboBox}" ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}" Margin="0,0,0,16">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumArabicNameConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Button Content="إضافة مستخدم" Style="{StaticResource PrimaryButton}" Command="{Binding AddUserCommand}" Margin="0,0,0,8"/>
                    <Button Content="حفظ التعديلات" Style="{StaticResource SecondaryButton}" Command="{Binding UpdateUserCommand}" Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="حذف" Style="{StaticResource DangerButton}" Command="{Binding DeleteUserCommand}" Margin="0,0,8,0"/>
                        <Button Content="تفعيل / تعطيل" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleActiveCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>