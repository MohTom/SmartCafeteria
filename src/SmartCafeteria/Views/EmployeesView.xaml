<UserControl x:Class="SmartCafeteria.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="الموظفون" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                <Button DockPanel.Dock="Left" Content="+ إضافة موظف" Style="{StaticResource PrimaryButton}" Padding="16,10"
                        Command="{Binding OpenEmployeeDialogCommand}"/>
            </DockPanel>
        </Border>

        <!-- Stats -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="عدد الموظفين النشطين" Style="{StaticResource FormLabel}"/>
                    <TextBlock Text="{Binding ActiveCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="إجمالي الرواتب الشهرية" Style="{StaticResource FormLabel}"/>
                    <TextBlock FontSize="24" FontWeight="Bold">
                        <Run Text="{Binding TotalSalaries, StringFormat='{}{0:N0}', Mode=OneWay}"/>
                        <Run Text="{Binding Settings.CurrencyAr}" FontSize="13"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Employees list -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <DockPanel>
                <TextBlock Text="قائمة الموظفين" Style="{StaticResource SectionTitle}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Employees}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" Margin="0,0,0,8" Background="#F8FAF9" CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                                <Border DockPanel.Dock="Right" Background="#E6F4EB" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Position, Converter={StaticResource EnumArabicNameConverter}}"
                                                               FontSize="10" Foreground="{StaticResource PrimaryBrush}"/>
                                                </Border>
                                            </DockPanel>
                                            <DockPanel Margin="0,6,0,0">
                                                <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock DockPanel.Dock="Left" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">
                                                    <Run Text="{Binding MonthlySalary, StringFormat='{}{0:N0}', Mode=OneWay}"/>
                                                    <Run FontSize="10" Text="{Binding DataContext.Settings.CurrencyAr, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                </TextBlock>
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="صرف راتب" Padding="12,7" Margin="4,0" Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding DataContext.OpenSalaryDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource IconButton}" ToolTip="تعديل" Margin="2"
                                                    Command="{Binding DataContext.OpenEditEmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                ✏
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" ToolTip="حذف" Margin="2" Background="#FDECEC" Foreground="{StaticResource ErrorBrush}"
                                                    Command="{Binding DataContext.DeleteEmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}">
                                                🗑
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Employee dialog -->
        <Border Grid.RowSpan="3" Background="#80000000"
                Visibility="{Binding ShowEmployeeDialog, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="16" Width="460" Padding="28"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="بيانات الموظف" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                    <TextBlock Text="الاسم الكامل" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="EmployeeNameBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                             Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="رقم الهاتف" Style="{StaticResource FormLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                             Text="{Binding NewPhone, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="الوظيفة" Style="{StaticResource FormLabel}"/>
                    <ComboBox Style="{StaticResource ModernComboBox}" Margin="0,0,0,12"
                              ItemsSource="{Binding Positions}" SelectedItem="{Binding NewPosition}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumArabicNameConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="الراتب الشهري" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="EmployeeSalaryBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                             Text="{Binding NewSalary, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="تاريخ التعيين" Style="{StaticResource FormLabel}"/>
                    <DatePicker SelectedDate="{Binding NewHireDate}" Margin="0,0,0,12" Style="{StaticResource ModernDatePicker}"/>
                    <TextBlock Text="ملاحظات" Style="{StaticResource FormLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NewNotes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="حفظ الموظف" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"
                                Command="{Binding SaveEmployeeCommand}"/>
                        <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Command="{Binding CloseEmployeeDialogCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Salary dialog -->
        <Border Grid.RowSpan="3" Background="#80000000"
                Visibility="{Binding ShowSalaryDialog, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="16" Width="420" Padding="28"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="صرف راتب" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SalaryEmployee.Name}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>
                    <TextBlock Text="المبلغ" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="SalaryAmountBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                             Text="{Binding SalaryAmount, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="ملاحظات" Style="{StaticResource FormLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SalaryNotes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    <TextBlock Text="يُسجل المبلغ كمصروف في فئة الرواتب تلقائياً"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="تأكيد الصرف" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"
                                Command="{Binding PaySalaryCommand}"/>
                        <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Command="{Binding CloseSalaryDialogCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
