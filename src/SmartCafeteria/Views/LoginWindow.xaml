<Window x:Class="SmartCafeteria.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول"
        Icon="pack://application:,,,/Resources/AppIcon.ico"
        Width="840" Height="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFontFamily}">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F4F7F5" Offset="0"/>
            <GradientStop Color="#E2F1E8" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Border Background="White" CornerRadius="18" Margin="18" Padding="32">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.16" Color="#0B3D1F"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Developer / contact info: visual right in the RTL window (column 0) -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock Text="معلومات التواصل" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="12" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="{StaticResource DeveloperCredit}"
                                   FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                   TextAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   AutomationProperties.AutomationId="DeveloperCredit"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    FlowDirection="LeftToRight" Margin="0,8,0,0">
                            <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{StaticResource DeveloperEmail}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    FlowDirection="LeftToRight" Margin="0,4,0,0">
                            <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{StaticResource DeveloperPhone}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="1" Width="1" Background="{StaticResource DividerBrush}" Margin="20,4"/>

            <!-- Login form: unchanged content and behaviour -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Resources/AppIcon.png"
                       Width="76" Height="76" Stretch="Uniform"
                       HorizontalAlignment="Center"
                       AutomationProperties.AutomationId="AppLogo"
                       AutomationProperties.Name="شعار الكافتيريا"/>
                <TextBlock Text="{Binding Settings.CafeteriaNameAr}" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Text="تسجيل الدخول إلى النظام" FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,24"/>

                <TextBlock Text="اسم المستخدم" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                <TextBlock Text="كلمة المرور" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordInput" Margin="0,0,0,18" Style="{StaticResource ModernPasswordBox}"
                             KeyDown="PasswordInput_KeyDown"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C0392B" FontSize="13"
                           TextWrapping="Wrap" Margin="0,0,0,12"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Button Content="دخول" Style="{StaticResource PrimaryButton}"
                        FontSize="16" Command="{Binding LoginCommand}" Margin="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
