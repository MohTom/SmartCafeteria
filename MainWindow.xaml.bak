                            <TextBlock Text="ðŸ“¦" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ø§Ù„Ù…Ø®Ø²ÙˆÙ†" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}"
