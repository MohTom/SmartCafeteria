                <!-- Bottom -->
                <Border DockPanel.Dock="Bottom" Padding="15" Margin="10,0,10,10" Background="#33FFFFFF" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="{Binding Settings.CashierName}" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding Settings.StationId}" Foreground="#AAFFFFFF" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- System Logs -->
                <Border DockPanel.Dock="Bottom" Padding="10" Margin="10,0,10,10" Background="#22FFFFFF" CornerRadius="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Ø³Ø¬Ù„ Ø§Ù„Ø¹Ù…Ù„ÙŠØ§Øª" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                        <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0"
                                 Foreground="#CCFFFFFF" FontSize="10" MaxHeight="120">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Column="1" Margin="20">
            <!-- ContentControl binds to CurrentViewModel -->
            <ContentControl Content="{Binding CurrentViewModel}" Margin="0,0,0,20">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:MenuViewModel}">
                        <views:MenuView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:CartViewModel}">
                        <views:CartView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:OrdersViewModel}">
                        <views:OrdersView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
                        <views:InventoryView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                        <views:ReportsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <views:SettingsView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>

            <!-- Notification Toast -->
<Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="{StaticResource PrimaryBrush}"
                    Padding="16,10" CornerRadius="8" Margin="0,0,0,10"
                    Visibility="{Binding ShowNotification, Converter={StaticResource BoolToVisibilityConverter}}"
                    Panel.ZIndex="100">
                <TextBlock Text="{Binding NotificationMessage}" FontSize="13" Foreground="White"/>
            </Border>
        </Grid>
    </Grid>
</Window>

