<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Smart Cafeteria" Language="1033" Version="1.0.0" Manufacturer="Smart Cafeteria"
           UpgradeCode="D1D537B7-2F81-46FC-AF8B-F6EE6FD10B5F" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Smart Cafeteria is already installed." />
    <Media Id="1" Cabinet="product.cab" EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="..\src\SmartCafeteria\Resources\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <Property Id="MACHINEGUID">
      <RegistrySearch Id="MachineGuidSearch" Root="HKLM"
                      Key="SOFTWARE\Microsoft\Cryptography" Name="MachineGuid" Type="raw" />
    </Property>

    <Feature Id="Main" Title="Smart Cafeteria" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExe" Guid="3A6B1C2D-4E5F-4A6B-8C9D-0E1F2A3B4C5D" Bitness="always64">
        <File Id="SmartCafeteriaExe" Source="..\publish\win-x64\SmartCafeteria.exe" KeyPath="yes" />
        <File Id="InstallMarker" Source="install.marker" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\SmartCafeteria"
                       Name="InstallMachineGuid" Type="string" Value="[MACHINEGUID]" />
      </Component>
      <Component Id="FontBlack" Directory="LatoFontFolder" Bitness="always64" Guid="3A6B1C2D-4E5F-4A6B-8C9D-0E1F2A3B4C61">
        <File Source="..\publish\win-x64\LatoFont\Lato-Black.ttf" />
      </Component>
      <Component Id="FontBlackItalic" Directory="LatoFontFolder" Bitness="always64" Guid="3A6B1C2D-4E5F-4A6B-8C9D-0E1F2A3B4C62">
        <File Source="..\publish\win-x64\LatoFont\Lato-BlackItalic.ttf" />
      </Component>
      <Component Id="FontBold" Directory="LatoFontFolder" Bitness="always64" Guid="3A6B1C2D-4E5F-4A6B-8C9D-0E1F2A3B4C63">
        <File Source="..\publish\win-x64\LatoFont\Lato-Bold.ttf" />
      </Component>
      <Component Id="FontBoldItalic" Directory="LatoFontFolder" Bitness="always64" Guid="3A6B1C2D-4E5F-4A6B-8C9D-0E1F2A3B4C64">
        <File Source="..\publish\win-x64\LatoFont\Lato-BoldItalic.ttf" />
      </Component>
      <Component Id="FontExtraBold" Directory="LatoFontFolder" Bitness="always64" Guid="3A6B1C2D-4E5F-4A6B-8C9D-0E1F2A3B4C65">
        <File Source="..\publish\win-x64\LatoFont\Lato-ExtraBold.ttf" />
      </Component>
      <Component Id="FontExtraBoldItalic" Directory="LatoFontFolder" Bitness="always64" Guid="3A6B1C2D-4E5F-4A6B-8C9D-0E1F2A3B4C66">
        <File Source="..\publish\win-x64\LatoFont\Lato-ExtraBoldItalic.ttf" />
      </Component>
      <Component Id="FontExtraLight" Directory="LatoFontFolder" Bitness="always64" Guid="3A6B1C2D-4E5F-4A6B-8C9D-0E1F2A3B4C67">
        <File Source="..\publish\win-x64\LatoFont\Lato-ExtraLight.ttf" />
      </Component>
      <Component Id="FontExtraLightItalic" Directory="LatoFontFolder" Bitness="always64" Guid="3A6B1C2D-4E5F-4A6B-8C9D-0E1F2A3B4C68">
        <File Source="..\publish\win-x64\LatoFont\Lato-ExtraLightItalic.ttf" />
      </Component>
      <Component Id="FontItalic" Directory="LatoFontFolder" Bitness="always64" Guid="3A6B1C2D-4E5F-4A6B-8C9D-0E1F2A3B4C69">
        <File Source="..\publish\win-x64\LatoFont\Lato-Italic.ttf" />
      </Component>
      <Component Id="FontLight" Directory="LatoFontFolder" Bitness="always64" Guid="3A6B1C2D-4E5F-4A6B-8C9D-0E1F2A3B4C6A">
        <File Source="..\publish\win-x64\LatoFont\Lato-Light.ttf" />
      </Component>
      <Component Id="FontLightItalic" Directory="LatoFontFolder" Bitness="always64" Guid="3A6B1C2D-4E5F-4A6B-8C9D-0E1F2A3B4C6B">
        <File Source="..\publish\win-x64\LatoFont\Lato-LightItalic.ttf" />
      </Component>
      <Component Id="FontMedium" Directory="LatoFontFolder" Bitness="always64" Guid="3A6B1C2D-4E5F-4A6B-8C9D-0E1F2A3B4C6C">
        <File Source="..\publish\win-x64\LatoFont\Lato-Medium.ttf" />
      </Component>
      <Component Id="FontMediumItalic" Directory="LatoFontFolder" Bitness="always64" Guid="3A6B1C2D-4E5F-4A6B-8C9D-0E1F2A3B4C6D">
        <File Source="..\publish\win-x64\LatoFont\Lato-MediumItalic.ttf" />
      </Component>
      <Component Id="FontRegular" Directory="LatoFontFolder" Bitness="always64" Guid="3A6B1C2D-4E5F-4A6B-8C9D-0E1F2A3B4C6E">
        <File Source="..\publish\win-x64\LatoFont\Lato-Regular.ttf" />
      </Component>
      <Component Id="FontSemiBold" Directory="LatoFontFolder" Bitness="always64" Guid="3A6B1C2D-4E5F-4A6B-8C9D-0E1F2A3B4C6F">
        <File Source="..\publish\win-x64\LatoFont\Lato-SemiBold.ttf" />
      </Component>
      <Component Id="FontSemiBoldItalic" Directory="LatoFontFolder" Bitness="always64" Guid="3A6B1C2D-4E5F-4A6B-8C9D-0E1F2A3B4C70">
        <File Source="..\publish\win-x64\LatoFont\Lato-SemiBoldItalic.ttf" />
      </Component>
      <Component Id="FontThin" Directory="LatoFontFolder" Bitness="always64" Guid="3A6B1C2D-4E5F-4A6B-8C9D-0E1F2A3B4C71">
        <File Source="..\publish\win-x64\LatoFont\Lato-Thin.ttf" />
      </Component>
      <Component Id="FontThinItalic" Directory="LatoFontFolder" Bitness="always64" Guid="3A6B1C2D-4E5F-4A6B-8C9D-0E1F2A3B4C72">
        <File Source="..\publish\win-x64\LatoFont\Lato-ThinItalic.ttf" />
      </Component>
      <Component Id="FontLicense" Directory="LatoFontFolder" Bitness="always64" Guid="3A6B1C2D-4E5F-4A6B-8C9D-0E1F2A3B4C73">
        <File Source="..\publish\win-x64\LatoFont\OFL.txt" />
      </Component>
    </ComponentGroup>

    <ui:WixUI Id="WixUI_Minimal" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Smart Cafeteria">
        <Directory Id="LatoFontFolder" Name="LatoFont" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Smart Cafeteria">
        <Component Id="StartMenuShortcut" Guid="3A6B1C2D-4E5F-4A6B-8C9D-0E1F2A3B4C80" Bitness="always64">
          <Shortcut Id="AppStartMenuShortcut" Name="Smart Cafeteria"
                    Target="[INSTALLFOLDER]SmartCafeteria.exe"
                    Icon="AppIcon" IconIndex="0" />
          <RemoveFolder Id="AppMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\SmartCafeteria" Name="StartMenu" Value="1"
                         Type="integer" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="3A6B1C2D-4E5F-4A6B-8C9D-0E1F2A3B4C81" Bitness="always64">
        <Shortcut Id="AppDesktopShortcut" Name="Smart Cafeteria"
                  Target="[INSTALLFOLDER]SmartCafeteria.exe"
                  Icon="AppIcon" IconIndex="0" />
        <RegistryValue Root="HKCU" Key="Software\SmartCafeteria" Name="Desktop" Value="1"
                       Type="integer" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Package>
</Wix>
